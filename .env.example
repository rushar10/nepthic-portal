# Nepthic Admin Portal — this project's own settings. Nothing here is shared with the sites
# except the PUBLIC half of the signing key, which each site holds.

# Its own Postgres database: admin accounts, sessions and the audit log. No customer data.
DATABASE_URL="postgresql://postgres@localhost:5432/nepthic_portal"

# Where the portal is served. Use its own subdomain, never a path on a customer site.
PORTAL_URL="https://admin.nepthic.com"

# Signing key for requests to the sites, and the key that encrypts 2FA secrets.
# Generate both with: npm run keys   (then put PORTAL_PUBLIC_KEY on each site)
PORTAL_PRIVATE_KEY=""
PORTAL_ENCRYPTION_KEY=""

# Sessions end after this much inactivity (minutes) and last at most this long (hours).
PORTAL_IDLE_MINUTES="30"
PORTAL_MAX_SESSION_HOURS="12"

# Optional extra protection: only these IPs / IPv4 ranges may open the portal at all
# (everyone else gets a 404). Comma separated, e.g. "203.0.113.10, 198.51.100.0/24".
# Empty = off. Recommended in addition: Cloudflare Access or a VPN in front of the portal.
PORTAL_IP_ALLOWLIST=""

# The sites. *_URL is the public address ("View live site"); *_API_URL is where the portal
# calls the site's admin API (defaults to the same address). An empty CLOTHING_API_URL shows
# Clothing as "not connected" until that site has the admin API (docs/admin-api.md).
CLOTHING_URL="https://www.nepthic.com"
CLOTHING_API_URL=""
WHOLESALE_URL="https://wholesale.nepthic.com"
EVENTS_URL="https://events.nepthic.com"

# Two-factor sign-in. "false" switches it off for now: email + password only, and sensitive
# actions ask for the password again instead of a code. Set to "true" (or remove) before launch.
PORTAL_REQUIRE_2FA="false"
